[Unit]
Description=EPQ FastAPI backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=epq
Group=epq
WorkingDirectory=/opt/epq
EnvironmentFile=/etc/epq/epq-backend.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/epq
ExecStart=/opt/epq/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

# Basic hardening while still allowing app writes to its storage directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/epq /opt/epq

[Install]
WantedBy=multi-user.target
