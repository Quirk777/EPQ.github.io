# Copy this file to .env.production on the VM. Do not commit real secrets.

# Domain and public URLs
DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com
FRONTEND_URL=https://example.com
ENVIRONMENT=production

# PostgreSQL container settings
POSTGRES_DB=epq
POSTGRES_USER=epq_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Backend runtime
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
SESSION_COOKIE_NAME=epq_session
HTTPS_ONLY_COOKIES=true
SESSION_SAME_SITE=lax
TRUSTED_PROXY_IPS=*
REPORTS_DIR=/app/reports
UPLOADS_DIR=/app/uploads
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf

# Email integration
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=EPQ Assessment Platform
