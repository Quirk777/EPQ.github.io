# Local development can continue using .env / .env.development with SQLite.
# For the VM deployment, copy .env.production.example to .env.production.

# --- Reverse proxy domain ---
DOMAIN=example.com

# --- Core runtime ---
ENVIRONMENT=production
PUBLIC_BASE_URL=https://example.com

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
HTTPS_ONLY_COOKIES=true
SESSION_SAME_SITE=lax
SESSION_COOKIE_NAME=epq_session
REQUIRE_EMAIL_VERIFICATION=true

# --- SQLite/report persistence for local or legacy container use ---
DB_PATH=/app/data/epq.db
SQLITE_PATH=/app/data/epq.db
REPORTS_DIR=/app/reports
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf

# --- PostgreSQL production settings ---
POSTGRES_DB=epq
POSTGRES_USER=epq_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# In Docker Compose production, DATABASE_URL is assembled automatically.
# For a manually managed VM service, set:
# DATABASE_URL=postgresql://epq_user:CHANGE_ME_LONG_RANDOM_PASSWORD@127.0.0.1:5432/epq

# --- Trusted reverse proxy headers ---
TRUSTED_PROXY_IPS=*

# --- Email (optional but recommended) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=EPQ Assessment Platform
